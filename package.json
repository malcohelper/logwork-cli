{
  "name": "logwork-cli",
  "version": "1.3.0",
  "description": "Log work to Resource Optimiser and Jira from the terminal, an MCP server for AI IDEs, and a terminal UI.",
  "license": "UNLICENSED",
  "type": "module",
  "homepage": "https://github.com/malcohelper/logwork-cli#readme",
  "bugs": {
    "url": "https://github.com/malcohelper/logwork-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malcohelper/logwork-cli.git"
  },
  "keywords": [
    "logwork",
    "resource-optimiser",
    "mcp-server",
    "ai-assistant",
    "nodejs",
    "macos",
    "windows",
    "keycloak",
    "codex",
    "cursor",
    "vscode",
    "claude-code",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "files": [
    "bin/",
    "commands/",
    "lib/",
    "skills/",
    "docs/",
    "examples/mcp/",
    "setup.sh",
    "README.md",
    "LICENSE",
    "RELEASE.md"
  ],
  "bin": {
    "logwork": "bin/logwork.mjs",
    "logwork-cli": "bin/logwork.mjs"
  },
  "scripts": {
    "start": "node bin/logwork.mjs",
    "dry-run": "LOGWORK_DRY_RUN=1 node bin/logwork.mjs",
    "mcp": "node bin/logwork.mjs mcp",
    "setup": "node bin/logwork.mjs setup",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "pack:check": "npm pack --dry-run",
    "release:doctor": "node bin/logwork.mjs release doctor --full",
    "lint": "eslint .",
    "release:check": "npm run lint && npm test && npm run audit:prod && npm run pack:check && git diff --check",
    "test:windows-credential": "node --import ./test/helpers/setup.mjs --test --test-name-pattern=\"Windows Credential Manager stores, reads, and deletes a test credential\" test/credential-store.test.mjs",
    "test": "node --import ./test/helpers/setup.mjs --test \"test/*.test.mjs\"",
    "test:coverage": "node --import ./test/helpers/setup.mjs --test --experimental-test-coverage --test-coverage-include=\"bin/**\" --test-coverage-include=\"commands/**\" --test-coverage-include=\"lib/**\" --test-coverage-lines=78 --test-coverage-branches=75 --test-coverage-functions=85 \"test/*.test.mjs\""
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "ink": "^7.0.5",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
